<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈阴影 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#AA000000" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <!-- 主体 -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#FF6B35" />
            <stroke android:width="2dp" android:color="#E55A2B" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <!-- 内部图标：画笔 -->
    <item android:top="30dp" android:left="30dp" android:right="30dp" android:bottom="30dp" android:drawable="@drawable/ic_pen" />
</layer-list>

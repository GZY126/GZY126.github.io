<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#FFF8F9FA"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SimpleDrawBot"
                android:textSize="16sp"
                android:textColor="#2C3E50"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCollapse"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="收起" />
        </LinearLayout>

        <!-- 标签切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:background="#E8ECF0"
            android:padding="2dp"
            app:cardCornerRadius="8dp">

            <TextView
                android:id="@+id/tabAiGenerate"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="AI 生成"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_tab_selected"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabWebSearch"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="搜图绘制"
                android:textSize="12sp"
                android:textColor="#666666"
                android:gravity="center"
                android:background="@drawable/bg_tab_unselected"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- AI生成内容区域 -->
        <LinearLayout
            android:id="@+id/layoutAiGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 状态提示 -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="就绪"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#7F8C8D"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <!-- 进度条 -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:progressTint="#FF6B35"
                android:layout_marginBottom="6dp" />

            <!-- 绘制模式切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:background="#F0F3F5"
                android:padding="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模式"
                    android:textSize="12sp"
                    android:textColor="#7F8C8D"
                    android:layout_marginEnd="6dp" />

                <RadioGroup
                    android:id="@+id/rgDrawMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbDrawAuto"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="自动加粗"
                        android:textSize="11sp"
                        android:checked="true"
                        android:gravity="center"
                        android:buttonTint="#27AE60" />

                    <RadioButton
                        android:id="@+id/rbDrawPrecise"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:text="单线精准"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:buttonTint="#2980B9" />
                </RadioGroup>
            </LinearLayout>

            <!-- 复杂度和线条粗细（合并行） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:background="#F0F3F5"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="细节"
                    android:textSize="11sp"
                    android:textColor="#7F8C8D" />

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginEnd="4dp">

                    <RadioButton
                        android:id="@+id/rbSimple"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="简"
                        android:textSize="10sp"
                        android:checked="true"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbComplex"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="中"
                        android:textSize="10sp"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbMax"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="满"
                        android:textSize="10sp"
                        android:gravity="center" />
                </RadioGroup>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#D5D8DC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="粗细"
                    android:textSize="11sp"
                    android:textColor="#7F8C8D"
                    android:layout_marginStart="4dp" />

                <RadioGroup
                    android:id="@+id/rgThickness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbThickThin"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="细"
                        android:textSize="10sp"
                        android:checked="true"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbThickMedium"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="中"
                        android:textSize="10sp"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbThickBold"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="粗"
                        android:textSize="10sp"
                        android:gravity="center" />
                </RadioGroup>
            </LinearLayout>

            <!-- 细节程度滑块 + 单线模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="细节量"
                    android:textSize="11sp"
                    android:textColor="#7F8C8D"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="10"
                    android:valueTo="100"
                    android:stepSize="10"
                    android:value="80" />

                <CheckBox
                    android:id="@+id/cbSingleLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="骨架"
                    android:textSize="10sp"
                    android:textColor="#7F8C8D"
                    android:checked="true"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp" />
            </LinearLayout>

            <!-- 绘画时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时长"
                    android:textSize="11sp"
                    android:textColor="#7F8C8D"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="5"
                    android:valueTo="60"
                    android:stepSize="1"
                    android:value="30" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30s"
                    android:textSize="12sp"
                    android:textColor="#2C3E50"
                    android:textStyle="bold"
                    android:minWidth="30dp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- 模型选择 + 速度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="4dp">

                <RadioGroup
                    android:id="@+id/rgModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbZTurbo"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="快"
                        android:textSize="10sp"
                        android:checked="true"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbZImage"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="细"
                        android:textSize="10sp"
                        android:gravity="center" />
                </RadioGroup>

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#D5D8DC"
                    android:layout_marginHorizontal="4dp" />

                <ImageButton
                    android:id="@+id/btnSpeedDown"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:contentDescription="减速" />

                <TextView
                    android:id="@+id/tvSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textSize="12sp"
                    android:textColor="#E67E22"
                    android:textStyle="bold"
                    android:minWidth="32dp"
                    android:gravity="center" />

                <ImageButton
                    android:id="@+id/btnSpeedUp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter"
                    android:contentDescription="加速" />
            </LinearLayout>

            <!-- 输入框 -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                android:layout_marginBottom="6dp"
                app:hintTextColor="#999999"
                android:hint="@string/input_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 按钮区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnSelectArea"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="选区"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:minWidth="0dp" />

                <Button
                    android:id="@+id/btnStartDraw"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="生成"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#FF6B35"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp" />

                <Button
                    android:id="@+id/btnPreviewDraw"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="预览"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#2980B9"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnConfirmDraw"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="开始画"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#27AE60"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="停止"
                    android:textSize="12sp"
                    android:backgroundTint="#E74C3C"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp" />
            </LinearLayout>

            <!-- 笔画预览区域 -->
            <FrameLayout
                android:id="@+id/layoutPreview"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="#ECF0F1"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="4dp"
                    android:contentDescription="笔画预览" />

                <TextView
                    android:id="@+id/tvPreviewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拖动框选 | 点击删笔"
                    android:textSize="10sp"
                    android:textColor="#E67E22"
                    android:textStyle="bold"
                    android:layout_gravity="top|start"
                    android:padding="3dp"
                    android:background="#DDFFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="top|end"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tvPreviewStrokes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#E67E22"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- 预览操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="3dp"
                android:visibility="gone"
                android:id="@+id/layoutPreviewButtons">

                <Button
                    android:id="@+id/btnCropPreview"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="框选裁剪"
                    android:textSize="10sp"
                    android:layout_marginEnd="3dp"
                    android:backgroundTint="#E67E22"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp" />

                <Button
                    android:id="@+id/btnDeleteStroke"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="删笔画"
                    android:textSize="10sp"
                    android:layout_marginEnd="3dp"
                    android:backgroundTint="#E74C3C"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp" />

                <Button
                    android:id="@+id/btnUndoDelete"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="撤回"
                    android:textSize="10sp"
                    android:layout_marginEnd="3dp"
                    android:backgroundTint="#2980B9"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnResetCrop"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="重置"
                    android:textSize="10sp"
                    android:backgroundTint="#95A5A6"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 绘制控制区域 -->
            <LinearLayout
                android:id="@+id/layoutDrawingControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressDraw"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:progressTint="#27AE60"
                    android:max="100"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp">

                    <TextView
                        android:id="@+id/tvDrawProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 / 0 笔"
                        android:textSize="11sp"
                        android:textColor="#2C3E50" />

                    <TextView
                        android:id="@+id/tvDrawEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="剩余 0s"
                        android:textSize="11sp"
                        android:textColor="#E67E22"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="3dp">

                    <Button
                        android:id="@+id/btnPauseResume"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="暂停"
                        android:textSize="11sp"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#F39C12"
                        android:textColor="#FFFFFF"
                        android:minWidth="0dp" />

                    <Button
                        android:id="@+id/btnStopDrawing"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:text="停止"
                        android:textSize="11sp"
                        android:backgroundTint="#E74C3C"
                        android:textColor="#FFFFFF"
                        android:minWidth="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 排序模式（可折叠） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="笔画顺序"
                    android:textSize="10sp"
                    android:textColor="#BDC3C7"
                    android:layout_marginBottom="1dp" />

                <RadioGroup
                    android:id="@+id/rgSortMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbSortTsp"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="TSP"
                        android:textSize="9sp"
                        android:checked="true"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbSortTopDown"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="上→下"
                        android:textSize="9sp"
                        android:gravity="center" />

                    <RadioButton
                        android:id="@+id/rbSortNone"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:text="原始"
                        android:textSize="9sp"
                        android:gravity="center" />
                </RadioGroup>
            </LinearLayout>

            <!-- 倒计时选项 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="4dp">

                <CheckBox
                    android:id="@+id/cbCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3秒倒计时"
                    android:textSize="10sp"
                    android:textColor="#95A5A6" />
            </LinearLayout>

        </LinearLayout>
        <!-- END layoutAiGenerate -->

        <!-- 搜图模式内容区域 -->
        <LinearLayout
            android:id="@+id/layoutWebSearch"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 搜索栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:paddingVertical="3dp"
                android:background="#F0F3F5"
                android:layout_marginBottom="3dp">

                <EditText
                    android:id="@+id/etWebSearchKeyword"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:hint="搜索关键词"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:paddingHorizontal="8dp"
                    android:background="@android:drawable/edit_text"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnWebSearch"
                    android:layout_width="46dp"
                    android:layout_height="32dp"
                    android:text="搜索"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#FF6B35"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp"
                    android:paddingHorizontal="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWebStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="长按图片下载，然后点击「提取轮廓画图」"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#7F8C8D"
                android:gravity="center"
                android:layout_marginBottom="3dp" />

            <WebView
                android:id="@+id/webViewSearch"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="4dp">

                <Button
                    android:id="@+id/btnWebExtractDraw"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="提取轮廓画图"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#27AE60"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp" />

                <Button
                    android:id="@+id/btnWebClearImage"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="清除"
                    android:textSize="11sp"
                    android:backgroundTint="#95A5A6"
                    android:textColor="#FFFFFF"
                    android:minWidth="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <!-- END layoutWebSearch -->

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
